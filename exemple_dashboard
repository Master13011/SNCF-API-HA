type: markdown
content: |

  {% for train in [
    'sensor.sncf_xx',
    'sensor.sncf_xx',
    'sensor.sncf_xx'
  ] %}

    {% set t = state_attr(train, 'departure_time') %}
    {% set b = state_attr(train, 'base_departure_time') %}
    {% set r_raw = state_attr(train, 'delay_minutes') %}
    {% set tr = state_attr(train, 'platform') %}
    {% set name = state_attr(train, 'direction') | default("N/A", true) %}

    {% set t_short = (t.split(' - ')[0][:5] ~ ' - ' ~ t.split(' - ')[1]) if t else 'N/A' %}
    {% set b_short = (b.split(' - ')[0][:5] ~ ' - ' ~ b.split(' - ')[1]) if b else 'N/A' %}

    {% if r_raw is not none and is_number(r_raw) %}
      {% set r = r_raw | int %}
      {% set s = "<s>" ~ b_short ~ "</s> " ~ t_short if r > 0 else t_short %}
      {% set st = "🚨 Retard: " ~ r ~ " min" if r > 0 else "✅ À l'heure" %}
    {% else %}
      {% set s = t_short %}
      {% set st = "N/A" %}
    {% endif %}

    **{{ s }} - {{ name }} - {{ st }} - {{ tr | default("N/A", true) }}**

  {% endfor %}
